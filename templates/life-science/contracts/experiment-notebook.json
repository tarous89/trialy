          "options": [
            "Planned",
            "In progress",
            "Review",
            "Completed",
            "Blocked"
          ]
        },
        {
          "key": "category",
          "label": "Assay",
          "kind": "text"
        },
        {
          "key": "owner",
          "label": "Scientist",
          "kind": "text"
        },
        {
          "key": "due",
