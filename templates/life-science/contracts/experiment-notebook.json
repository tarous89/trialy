  "screens": [
    {
      "name": "Research Overview",
      "kind": "overview",
      "role": "experiments",
      "description": "Your research in progress, with evidence close at hand.",
      "route": "research-overview"
    },
    {
      "name": "Experiment Directory",
      "kind": "table",
      "role": "experiments",
      "description": "Plans, methods and observations in one place.",
      "route": "experiment-directory"
    },
    {
      "name": "Experiment Entry",
      "kind": "form",
      "role": "experiments",
      "description": "Capture the method and the observation separately.",
      "route": "experiment-entry"
    },
    {
      "name": "Protocol References",
      "kind": "table",
      "role": "documents",
      "description": "Exact method versions inside your notebook.",
      "route": "protocol-references"
    },
    {
      "name": "Results & Findings",
      "kind": "science",
      "role": "measurements",
      "description": "Recorded measurements, with units and controls.",
      "route": "results-findings"
    },
    {
      "name": "Research Summary",
      "kind": "report",
      "role": "reports",
      "description": "Reflect on your results with a source-linked research memo.",
      "route": "research-summary"
    }
  ],
