{
  "registry": "role-contracts",
  "version": "2026-11-12",
  "source": "docs/product/MODULAR_APPS_AND_SHARED_DATA.md#7-role-based-connections-standard-for-all-apps",
  "rules": "Output roles (kind output) are read-only results that one app writes and any app may read. One live writer per output table; other apps bind it read-only. A custom app may take over writing only after the current writer is archived or permanently deleted, with an explicit owner choice. Additive changes keep a version compatible; a breaking change is a new version. A reader declares the versions it reads; it also connects to a newer version that is a superset (every field of the version it reads, same kind, cardinality and options). Core roles are listed in templates/core-contract/v1.json and stay multi-writer. Roles of kind app are an app's working tables published for readers; the single-writer rule does not apply to them.",
  "roles": {
    "runway.month_closes": {
      "name": "Runway month closes",
      "kind": "output",
      "writer": "life.cash-runway",
      "description": "Frozen month-end snapshots. metrics holds the frozen JSON snapshot (v, asOf, currency, months[]).",
      "versions": {
        "runway.v2": {
          "fields": [
            {
              "key": "month",
              "name": "Month",
              "kind": "date",
              "required": true,
              "multiple": false,
              "description": "Stored as the first day of the month."
            },
            {
              "key": "closing_balance",
              "name": "Closing bank balance",
              "kind": "money",
              "required": true,
              "multiple": false
            },
            {
              "key": "currency",
              "name": "Currency",
              "kind": "select",
              "required": true,
              "multiple": false,
              "options": [
                "USD",
                "EUR",
                "GBP",
                "CHF",
                "CAD",
                "AUD",
                "JPY",
                "CNY",
                "SEK",
                "DKK",
                "NOK",
                "INR"
              ]
            },
            {
              "key": "closed",
              "name": "Closed",
              "kind": "boolean",
              "required": false,
              "multiple": false
            },
            {
              "key": "commentary",
              "name": "Commentary",
              "kind": "text",
              "required": false,
              "multiple": false
            },
            {
              "key": "runway_months",
              "name": "Runway",
              "kind": "number",
              "required": false,
              "multiple": false
            },
            {
              "key": "cash_out_month",
              "name": "Cash-out month",
              "kind": "date",
              "required": false,
              "multiple": false
            },
            {
              "key": "runway_status",
              "name": "Runway status",
              "kind": "select",
              "required": false,
              "multiple": false,
              "options": [
                "ok",
                "below_target"
              ]
            },
            {
              "key": "metrics",
              "name": "Frozen metrics",
              "kind": "text",
              "required": false,
              "multiple": false,
              "description": "Frozen JSON snapshot written once at close; read-only. App output for other apps."
            },
            {
              "key": "rates_used",
              "name": "Rates used",
              "kind": "text",
              "required": false,
              "multiple": false,
              "description": "Frozen JSON of exchange rates used; read-only."
            },
            {
              "key": "closed_at",
              "name": "Closed on",
              "kind": "date",
              "required": false,
              "multiple": false
            }
          ]
        }
      }
    },
