  "pipeline.items": {
    "name": "Plan items",
    "description": "Programs, milestones, activities and decisions. A milestone belongs to a program; activities and decisions belong to a program or a milestone.",
    "contract": "pipeline.v1",
    "fields": [
      {
        "key": "name",
        "name": "Name",
        "kind": "text",
        "required": true,
        "multiple": false,
        "ai": true
      },
      {
        "key": "item_type",
        "name": "Record type",
        "kind": "select",
        "required": true,
        "multiple": false,
        "options": [
          "Program",
          "Milestone",
          "Activity",
          "Decision"
        ],
        "ai": true
      },
      {
        "key": "parent_id",
        "name": "Parent item",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "Record ID of the parent plan item (a program, or for activities and decisions a program or a milestone). Empty for programs.",
        "ai": true
      },
      {
        "key": "parent_rule",
        "name": "Dependency on parent",
        "kind": "select",
        "required": false,
        "multiple": false,
        "options": [
          "start",
          "finish"
        ],
        "description": "start: this item must complete before the parent can start; finish: before the parent can complete. Empty: optional.",
        "ai": true
      },
      {
        "key": "parent_outcome",
        "name": "Required decision outcome",
        "kind": "select",
        "required": false,
        "multiple": false,
        "options": [
          "Approved",
          "Conditional",
          "No-go"
        ],
        "description": "For a decision with a dependency rule: the outcome the parent needs.",
        "ai": true
      },
      {
        "key": "description",
        "name": "Description",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "asset",
        "name": "Assets",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "Programs only.",
        "ai": true
      },
      {
        "key": "disease",
        "name": "Disease",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "Programs only.",
        "ai": true
      },
      {
        "key": "stage",
        "name": "Stage",
        "kind": "select",
        "required": false,
        "multiple": false,
        "options": [
          "Discovery",
          "Preclinical",
          "Phase 1",
          "Phase 2",
          "Phase 3"
        ],
        "description": "Programs only.",
        "ai": true
      },
      {
        "key": "start_date",
        "name": "Baseline start date",
        "kind": "date",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "end_date",
        "name": "Baseline end or target date",
        "kind": "date",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "earliest_date",
        "name": "Earliest date",
        "kind": "date",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "latest_date",
        "name": "Latest date",
        "kind": "date",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "owner",
        "name": "Owner",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "status",
        "name": "Status",
        "kind": "select",
        "required": true,
        "multiple": false,
        "options": [
          "Planned",
          "In progress",
          "Pending",
          "On hold",
          "Completed",
          "Cancelled"
        ],
        "ai": true
      },
      {
        "key": "decision_outcome",
        "name": "Decision outcome",
        "kind": "select",
        "required": false,
        "multiple": false,
        "options": [
          "Approved",
          "Conditional",
          "No-go"
        ],
        "ai": true
      },
      {
        "key": "budget",
        "name": "Approved budget",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "spend",
        "name": "Spend to date",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "reserve",
        "name": "Contingency",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "team",
        "name": "Team members",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "Names, separated by commas.",
        "ai": true
      },
      {
        "key": "organization_ids",
        "name": "Organizations",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "Record IDs of organizations records, separated by commas.",
        "ai": true
      },
      {
        "key": "files",
        "name": "Files",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "JSON list of TrialAgents document versions: [{\"v\":\"<document version ID>\",\"n\":\"<file name>\"}].",
        "ai": true
      },
      {
        "key": "approved_on",
        "name": "Completion approved on",
        "kind": "date",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "approved_owner",
        "name": "Completion approved for owner",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "The owner named on the item when completion was approved; the record history shows who approved it.",
        "ai": true
      },
      {
        "key": "client_ref",
        "name": "Client reference",
        "kind": "text",
        "required": false,
        "multiple": false,
        "description": "Set by the app when it creates the record, to reopen it after saving.",
        "ai": true
      },
      {
        "key": "archived",
        "name": "Archived",
        "kind": "boolean",
        "required": false,
        "multiple": false,
        "ai": true
      }
    ],
    "logicalFields": {
      "name": "name",
      "item_type": "item_type",
      "parent_id": "parent_id",
      "parent_rule": "parent_rule",
      "parent_outcome": "parent_outcome",
      "description": "description",
      "asset": "asset",
      "disease": "disease",
      "stage": "stage",
      "start_date": "start_date",
      "end_date": "end_date",
      "earliest_date": "earliest_date",
      "latest_date": "latest_date",
      "owner": "owner",
      "status": "status",
      "decision_outcome": "decision_outcome",
      "budget": "budget",
      "spend": "spend",
      "reserve": "reserve",
      "team": "team",
      "organization_ids": "organization_ids",
      "files": "files",
      "approved_on": "approved_on",
      "approved_owner": "approved_owner",
      "client_ref": "client_ref",
      "archived": "archived"
    }
  },
