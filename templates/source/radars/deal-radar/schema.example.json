  "dealradar.settings": {
    "name": "Deal Radar settings",
    "contract": "dealradar.v1",
    "fields": [
      {
        "key": "lookback_days",
        "name": "Lookback (days)",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "First-run lookback when a scope has no completed run yet. Default 90."
      },
      {
        "key": "impact_scale",
        "name": "Impact scale",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object: {high, medium, low, none} → one line on what each level means for you. Blank uses the standard scale."
      },
      {
        "key": "research_template",
        "name": "Research template",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON {instruction, rules:[...]}: the editable part of the research template. The required rules are added by the app and cannot be removed."
      },
      {
        "key": "research_template_version",
        "name": "Research template version",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true
      },
      {
        "key": "research_template_history",
        "name": "Research template history",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON array of earlier versions {version, saved_on, note, template}. The newest 20 are kept."
      },
      {
        "key": "field_labels",
        "name": "Field labels",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object: tracker field key → label shown in the app (renaming a field for display)."
      },
      {
        "key": "hidden_fields",
        "name": "Hidden fields",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON array of tracker field keys hidden in the table. Hidden fields stay in the research and the brief."
      },
      {
        "key": "language",
        "name": "Language",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Language for summaries and emails. Default English."
      }
    ],
    "logicalFields": {
      "lookback_days": "lookback_days",
      "impact_scale": "impact_scale",
      "research_template": "research_template",
      "research_template_version": "research_template_version",
      "research_template_history": "research_template_history",
      "field_labels": "field_labels",
      "hidden_fields": "hidden_fields",
      "language": "language"
    }
  },
