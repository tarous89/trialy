  "sources": [
    {
      "name": "Company pipelines and press releases",
      "covers": "Pipeline pages, press releases, investor presentations.",
      "priority": 1,
      "notes": "Use the public site on the web."
    },
    {
      "name": "Public pipeline summaries",
      "covers": "Pharmaprojects-type public summaries, trade press databases (free parts).",
      "priority": 2,
      "notes": "Summarise; do not copy paid content."
    },
    {
      "name": "News",
      "covers": "Trade and business news.",
      "priority": 3,
      "notes": "Use the public site on the web."
    }
  ],
  "instruction": "You watch competing assets for the scopes below. For each active scope, find assets that match its indication, mechanism or target, modality, line and geographies, and changes since the last run: new entrants, phase changes, partnerships, discontinuations and readouts. Keep each asset current in the Assets table and record each change as an event. Mark estimated milestone dates as estimates. Explain in one or two sentences why each high-impact change matters for the scope's program (so_what).",
  "examplePrompts": [
    {
      "prompt": "Set up Pipeline Radar for our LPA1 program and build it now.",
      "expectedBehavior": "Install Pipeline Radar, add a scope (indication, mechanism LPA1), then Build now in chat: the assistant reads the brief, fills Assets and events with sources and saves a run with its source report."
    },
    {
      "prompt": "Who entered the IPF space this quarter?",
      "expectedBehavior": "Read Pipeline Radar events of kind new_entrant for the scope and summarise them with sources. Nothing is written."
    }
  ]
}
