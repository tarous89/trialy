      "key": "new_entrant",
      "label": "New entrant"
    },
    {
      "key": "phase_change",
      "label": "Phase change"
    },
    {
      "key": "partnership",
      "label": "Partnership"
    },
    {
      "key": "discontinuation",
      "label": "Discontinuation"
    },
    {
      "key": "readout",
      "label": "Readout"
    },
    {
      "key": "other",
      "label": "Other"
    }
  ],
  "digestSection": {
    "title": "Phase changes and new entrants",
    "kinds": [
      "phase_change",
      "new_entrant",
      "discontinuation"
    ],
    "hint": "phase changes, new entrants"
  },
  "listColumns": [
    "name",
    "company_name",
    "mechanism",
    "modality",
    "phase",
    "indications",
    "next_milestone_on",
    "status"
  ],
  "optionLabels": {
    "phase_1": "Phase 1",
    "phase_2": "Phase 2",
    "phase_3": "Phase 3",
    "small_molecule": "Small molecule",
    "cell_therapy": "Cell therapy",
    "gene_therapy": "Gene therapy",
