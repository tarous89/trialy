{
  "kit": "2.0.0",
  "slug": "pipeline-radar",
  "id": "life.pipeline-radar",
  "version": "2.0.0",
  "upgradeFrom": [
    "1.0.0",
    "1.0.1"
  ],
  "name": "Pipeline Radar",
  "prefix": "pipelineradar",
  "trackerTable": "assets",
  "trackerLabel": "Assets",
  "itemLabel": "asset",
  "itemsLabel": "assets",
  "cadence": "weekly",
  "itemNameField": "name",
  "scopeFields": [
    {
      "key": "indication",
      "name": "Indication",
      "kind": "text",
      "required": true,
      "placeholder": "e.g. idiopathic pulmonary fibrosis"
    },
    {
      "key": "mechanism",
      "name": "Mechanism or target",
      "kind": "text",
      "placeholder": "e.g. LPA1, autotaxin"
    },
    {
      "key": "modality",
      "name": "Modality",
      "kind": "text",
      "placeholder": "e.g. small molecule, antibody"
    },
    {
      "key": "line",
      "name": "Line of therapy",
      "kind": "text",
      "placeholder": "e.g. first line, add-on"
    },
    {
      "key": "geographies",
      "name": "Geographies",
      "kind": "text",
      "placeholder": "e.g. US, EU, China"
    }
  ],
  "trackerFields": [
    {
      "key": "name",
      "name": "Asset",
      "kind": "text",
      "required": true
    },
    {
      "key": "organization_id",
      "name": "Company",
      "kind": "text",
      "description": "Record ID of an organizations record."
    },
    {
      "key": "company_name",
      "name": "Company name",
      "kind": "text"
    },
    {
      "key": "partner_ids",
      "name": "Partners",
      "kind": "text",
      "description": "Comma-separated organizations record IDs."
    },
    {
      "key": "partner_names",
      "name": "Partner names",
      "kind": "text"
    },
    {
      "key": "mechanism",
      "name": "Mechanism",
      "kind": "text"
    },
    {
      "key": "modality",
      "name": "Modality",
      "kind": "select",
      "options": [
        "small_molecule",
        "antibody",
        "biologic",
        "cell_therapy",
        "gene_therapy",
        "rna",
        "vaccine",
        "other"
      ]
    },
    {
      "key": "phase",
      "name": "Phase",
      "kind": "select",
      "options": [
        "preclinical",
        "phase_1",
        "phase_2",
        "phase_3",
        "filed",
        "approved",
        "discontinued"
      ]
    },
    {
      "key": "indications",
      "name": "Indications",
      "kind": "text"
    },
    {
      "key": "line",
      "name": "Line",
      "kind": "text"
    },
    {
      "key": "status",
      "name": "Status",
      "kind": "select",
      "options": [
        "active",
        "on_hold",
        "discontinued",
        "unknown"
      ]
    },
    {
      "key": "next_milestone",
      "name": "Next milestone",
      "kind": "text"
    },
    {
      "key": "next_milestone_on",
      "name": "Next milestone date",
      "kind": "date"
    },
    {
      "key": "next_milestone_estimated",
      "name": "Milestone date is an estimate",
      "kind": "boolean"
    },
    {
      "key": "own",
      "name": "Our own asset",
      "kind": "boolean"
    }
  ],
  "naturalKey": {
    "label": "company and asset",
    "rule": "Company name and asset name (code or INN), lower case, joined by \"|\", e.g. \"maplecrest pharma|fx-101\"."
  },
  "dateField": {
    "key": "next_milestone_on",
