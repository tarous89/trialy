  "croselection.settings": {
    "name": "CRO Selection settings",
    "contract": "croselection.v1",
    "fields": [
      {
        "key": "default_currency",
        "name": "Default currency",
        "kind": "select",
        "required": false,
        "multiple": false,
        "ai": true,
        "options": [
          "USD",
          "EUR",
          "GBP",
          "CHF",
          "CAD",
          "AUD",
          "JPY",
          "CNY",
          "SEK",
          "DKK",
          "NOK",
          "INR"
        ]
      },
      {
        "key": "blind_scoring",
        "name": "Blind scoring",
        "kind": "boolean",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Default true: prices are hidden in Evaluation until every reviewer has scored every finalist, or a person reveals them."
      },
      {
        "key": "question_deadline_days",
        "name": "Question deadline (days before the response deadline)",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Default 7."
      },
      {
        "key": "confidentiality_text",
        "name": "Confidentiality text",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Shown to suppliers before they see shared documents (click-through gate)."
      },
      {
        "key": "decision_texts",
        "name": "Decision texts",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object {winner, unsuccessful, debrief}: default texts of the decision notices."
      },
      {
        "key": "email_texts",
        "name": "Email texts",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object {rfi|rfp|quick_quote:{invitation|reminder|clarification|message|extended|revoked:{subject,body}}}: the app defaults per request kind and exchange email type. Missing entries use the built-in texts."
      }
    ],
    "logicalFields": {
      "default_currency": "default_currency",
      "blind_scoring": "blind_scoring",
      "question_deadline_days": "question_deadline_days",
      "confidentiality_text": "confidentiality_text",
      "decision_texts": "decision_texts",
      "email_texts": "email_texts"
    }
  },
