  "labinventory.settings": {
    "name": "Lab Inventory settings",
    "contract": "labinventory.v1",
    "fields": [
      {
        "key": "approver",
        "name": "Approver",
        "kind": "text",
        "required": true,
        "multiple": false,
        "ai": true,
        "description": "Name of the default approver (the lab manager)."
      },
      {
        "key": "second_approver",
        "name": "Second approver",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Approves requests whose estimated amount is above the threshold."
      },
      {
        "key": "threshold_amount",
        "name": "Threshold amount",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Blank: one approval for every amount."
      },
      {
        "key": "currency",
        "name": "Currency",
        "kind": "select",
        "required": false,
        "multiple": false,
        "ai": true,
        "options": [
          "EUR",
          "USD",
          "GBP",
          "CHF",
          "DKK",
          "SEK",
          "NOK",
          "JPY",
          "CAD",
          "AUD"
        ],
        "description": "Settings currency for amounts and reports. Default EUR."
      },
      {
        "key": "program_approvers",
        "name": "Program approvers",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON {\"<programs record ID>\":\"<approver name>\"}; replaces the default approver for that program."
      },
      {
        "key": "expiry_window_days",
        "name": "Expiry window (days)",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Default 30."
      },
      {
        "key": "digest_cadence",
        "name": "Digest cadence",
        "kind": "select",
        "required": false,
        "multiple": false,
        "ai": true,
        "options": [
          "daily",
          "weekly",
          "monthly"
        ],
        "description": "Default weekly."
      },
      {
        "key": "digest_day",
        "name": "Digest day",
        "kind": "select",
        "required": false,
        "multiple": false,
        "ai": true,
        "options": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ],
        "description": "Default mon."
      },
      {
        "key": "digest_time",
        "name": "Digest time",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "HH:MM, default 08:00."
      },
      {
        "key": "digest_recipients",
        "name": "Digest recipients",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Names of the workspace members who get the digest (the automation holds the actual recipients)."
      },
      {
        "key": "digest_text",
        "name": "Digest text",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Intro line of the digest email."
      },
      {
        "key": "units",
        "name": "Units",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Comma-separated units offered for items. Default: bottle, box, vial, pack, tube, kit, plate, flask, bag, each."
      },
      {
        "key": "app_link",
        "name": "App link for QR codes",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "The app address (https://…/apps/<app id>?workspaceId=<id>) used to build QR codes for items and locations."
      }
    ],
    "logicalFields": {
      "approver": "approver",
      "second_approver": "second_approver",
      "threshold_amount": "threshold_amount",
      "currency": "currency",
      "program_approvers": "program_approvers",
      "expiry_window_days": "expiry_window_days",
      "digest_cadence": "digest_cadence",
      "digest_day": "digest_day",
      "digest_time": "digest_time",
      "digest_recipients": "digest_recipients",
      "digest_text": "digest_text",
      "units": "units",
      "app_link": "app_link"
    }
  },
