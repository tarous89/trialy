   },
   {
    "key": "modalities",
    "name": "Modalities",
    "kind": "text",
    "required": false,
    "multiple": false,
    "ai": true,
    "description": "Comma list of modalities used for fit, for example small_molecule, antibody, cell_therapy."
   },
   {
    "key": "therapeutic_areas",
    "name": "Therapeutic areas",
    "kind": "text",
    "required": false,
    "multiple": false,
    "ai": true,
    "description": "Comma list of therapeutic areas used for fit, for example oncology, immunology, neurology."
   },
   {
    "key": "dev_stages",
    "name": "Development stages",
    "kind": "text",
    "required": false,
    "multiple": false,
    "ai": true,
    "description": "Comma list of development stages used for fit, for example discovery, preclinical, phase_1."
   }
  ],
