  "investorupdates.settings": {
    "name": "Investor Updates settings",
    "contract": "investorupdates.v1",
    "fields": [
      {
        "key": "sender_display",
        "name": "Sender display",
        "kind": "select",
        "required": false,
        "multiple": false,
        "ai": true,
        "options": [
          "organization",
          "first_name"
        ],
        "description": "\"<Organization> at TrialAgents\" or \"<First name> at TrialAgents\". Blank: organization."
      },
      {
        "key": "approval_steps",
        "name": "Approval steps",
        "kind": "select",
        "required": false,
        "multiple": false,
        "ai": true,
        "options": [
          "one",
          "two"
        ],
        "description": "one: approver 2 approves. two: approver 1 checks the numbers first. Blank: one."
      },
      {
        "key": "help_enabled",
        "name": "\"I can help\" on",
        "kind": "boolean",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "App-wide. Blank counts as on. Off: asks render as plain text everywhere and no responses are collected."
      },
      {
        "key": "questions_enabled",
        "name": "Questions on",
        "kind": "boolean",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "App-wide. Blank counts as on."
      },
      {
        "key": "meeting_lead_days",
        "name": "Meeting lead time (days)",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Days before a meeting its before part is due. Blank: 7."
      },
      {
        "key": "confidentiality_footer",
        "name": "Confidentiality footer",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Shown at the end of every update; {recipient_name} allowed."
      },
      {
        "key": "email_texts",
        "name": "Email default texts",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON {update|meeting_before|meeting_after|answer|reminder: {subject, body}} with the exchange placeholders. Blank uses the standard texts."
      },
      {
        "key": "custom_fields",
        "name": "Custom fields",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON array [{table, key, label, kind, options?}] of fields added to recipients, meetings or updates (§8a)."
      },
      {
        "key": "labels",
        "name": "Labels",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object {board|investors|shareholders|everyone|<screen id>: label}."
      },
      {
        "key": "preferences",
        "name": "Preferences",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object {opening_screen, page_size, overview_hidden: [...]}."
      }
    ],
    "logicalFields": {
      "sender_display": "sender_display",
      "approval_steps": "approval_steps",
      "help_enabled": "help_enabled",
      "questions_enabled": "questions_enabled",
      "meeting_lead_days": "meeting_lead_days",
      "confidentiality_footer": "confidentiality_footer",
      "email_texts": "email_texts",
      "custom_fields": "custom_fields",
      "labels": "labels",
      "preferences": "preferences"
    }
  },
