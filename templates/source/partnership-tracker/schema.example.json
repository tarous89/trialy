  "partnerships.settings": {
    "name": "Partnerships settings",
    "contract": "partnerships.v1",
    "fields": [
      {
        "key": "digest_text",
        "name": "Digest email text",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Optional intro line the research worker puts at the top of the digest summary."
      },
      {
        "key": "stalled_days",
        "name": "Stalled after (days)",
        "kind": "number",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Default 21."
      },
      {
        "key": "lost_reasons",
        "name": "Lost reasons",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON array of reason labels. Blank uses the standard list."
      },
      {
        "key": "team",
        "name": "Team",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "Comma-separated names of the people who own opportunities and follow-ups (plain text)."
      },
      {
        "key": "team_members",
        "name": "Team member IDs",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON object {\"Name\": \"workspace member UUID\"}. Follow-ups copy the owner's member ID so reminders reach that member; names without an ID go to the automation's recipients."
      },
      {
        "key": "custom_fields",
        "name": "Custom fields",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON array [{table, key, label, kind, options, column, filter}]: fields added to an app or shared table that the app shows as optional columns, filters, drawer rows and editor inputs. table is one of opportunities, organizations, people, activities, follow_ups, conferences; kind is text, longtext, number, date, select or boolean."
      },
      {
        "key": "option_lists",
        "name": "Option lists",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON {\"activity_kinds\": {\"key\": \"Label\"}, \"deal_types\": {\"key\": \"Label\"}}: renamed or added values. A new activity kind also needs the option added to partnerships.activities.kind. Add \"hidden\": [keys] inside a list to hide values from new entries."
      },
      {
        "key": "stage_config",
        "name": "Stage configuration",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON {\"labels\": {\"stage\": \"Label\"}, \"hidden\": [stages], \"custom\": [{\"key\", \"label\", \"after\"}]}. Standard stage keys never change; a custom stage needs its option added to partnerships.opportunities.stage and counts in the funnel at the standard stage it follows."
      },
      {
        "key": "preferences",
        "name": "Preferences",
        "kind": "text",
        "required": false,
        "multiple": false,
        "ai": true,
        "description": "JSON {\"pipeline_layout\": \"board|list|funnel\", \"default_view\": \"view record ID\", \"page_size\": 10-50, \"overview_hidden\": [\"funnel_asset\",\"funnel_direction\",\"followups\",\"stalled\",\"upcoming\",\"signals\"]}."
      }
    ],
    "logicalFields": {
      "digest_text": "digest_text",
      "stalled_days": "stalled_days",
      "lost_reasons": "lost_reasons",
      "team": "team",
      "team_members": "team_members",
      "custom_fields": "custom_fields",
      "option_lists": "option_lists",
      "stage_config": "stage_config",
      "preferences": "preferences"
    }
  },
