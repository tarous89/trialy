{
  "name": "trialagents-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "node --import tsx scripts/build-vivid-template.ts --check && tsc --noEmit && vite build && node --import tsx scripts/build-embed.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "export:verify": "node --import tsx scripts/verify-export.ts",
    "recovery:inventory": "node --env-file-if-exists=.env --import tsx scripts/recovery-inventory.ts",
    "recovery:rehearse": "node --import tsx scripts/rehearse-recovery.ts",
    "db:runtime-audit": "node --env-file-if-exists=.env --import tsx scripts/runtime-audit.ts",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.51.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
