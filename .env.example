NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
BRAND_NAME=Trialy
DATABASE_URL=postgres://trialy:trialy@localhost:5432/trialy
# Generate a random secret of at least 32 characters. Never commit the real value.
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# JWT bearer tokens for MCP: issuer, JWKS URL, audience, and required scope.
MCP_ISSUER=
MCP_JWKS_URL=
MCP_AUDIENCE=
MCP_SCOPE=trialy
# Explicit local-only synthetic account. Refused outside development or loopback.
LOCAL_DEMO=false
MAX_FILE_BYTES=26214400
