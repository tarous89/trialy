NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# Optional browser origin; activate only after custom-domain DNS and TLS work.
# PUBLIC_URL is the canonical MCP/OAuth origin; production uses https://platform.trialagents.com.
# APP_PUBLIC_URL=https://platform.trialagents.com
# Explicit same-service compatibility URL for pre-migration OAuth clients only:
# LEGACY_MCP_RESOURCE_URL=https://trialy-web.onrender.com/mcp
BRAND_NAME=TrialAgents
DATABASE_URL=postgres://trialy:trialy@localhost:5432/trialy
# Generate a random secret of at least 32 characters. Never commit the real value.
SESSION_SECRET=
# Self-hosted sign-in and MCP OAuth use PUBLIC_URL; no external identity provider.
MAX_FILE_BYTES=26214400
# Optional separate migration credential (prefer a dedicated deployment job in production).
# MIGRATION_DATABASE_URL=

# Optional stable MFA encryption key (at least 32 characters). Defaults to SESSION_SECRET.
# Preserve the chosen key; changing it requires re-encrypting enrolled secrets.
# MFA_ENCRYPTION_KEY=

# Staged simple-app/connector backend. Keep disabled until the approved UI and release checks are complete.
SIMPLE_APPS_ENABLED=false
# Independent AES-256-GCM key: a random 32-byte value encoded as base64. Never put a real key in this file.
# CONNECTOR_ENCRYPTION_KEY=
# Optional comma-separated previous base64 keys for decrypting credentials during rotation.
# CONNECTOR_PREVIOUS_ENCRYPTION_KEYS=

# Optional shared ChatGPT automations. A kill switch that does not disable apps.
APP_AUTOMATIONS_ENABLED=true
# Web and worker must share CONNECTOR_ENCRYPTION_KEY (and previous keys during rotation).
